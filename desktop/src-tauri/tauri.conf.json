{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agentic OS",
  "version": "1.0.0",
  "identifier": "com.agenticos.app",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../frontend/dist",
    "beforeDevCommand": {
      "script": "npm run dev:frontend",
      "cwd": "../..",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "npm run build:frontend",
      "cwd": "../.."
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agentic OS",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:* http://localhost:* ws://localhost:*; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: http://127.0.0.1:* http://localhost:*; frame-src http://127.0.0.1:* http://localhost:*; media-src 'self' blob:; worker-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "shortDescription": "Orquestador de agentes de IA",
    "publisher": "Agentic OS"
  }
}
